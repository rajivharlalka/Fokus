# AviationStack API key (optional — enables live flight data)
# Get a free key at https://aviationstack.com/
# Add this in Vercel: Project → Settings → Environment Variables
AVIATIONSTACK_API_KEY=

# Set to true only if your AviationStack plan supports HTTPS
# AVIATIONSTACK_USE_HTTPS=false

# Prefer server-only AVIATIONSTACK_API_KEY (never commit real keys)
# NEXT_PUBLIC_AVIATIONSTACK_API_KEY=
