# Flight Data API Configuration

# AviationStack API
# Sign up at: https://aviationstack.com/
AVIATION_STACK_API_KEY=your_api_key_here

# FlightAware AeroAPI
# Sign up at: https://www.flightaware.com/commercial/aeroapi/
FLIGHTAWARE_API_KEY=your_api_key_here

# OpenSky Network (Free - No API key required)
# Documentation: https://opensky-network.org/apidoc/

# App Configuration
USE_MOCK_DATA=false
USE_OPENSKY=true
